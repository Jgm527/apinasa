{
  "info": {
    "name": "NASA Spring Guide",
    "description": "Peticiones de ejemplo a las APIs de NASA que usa el proyecto. Usa el entorno «NASA» y rellena NASA_API_KEY.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "ejemplo-rest: saludo (local)",
      "request": {
        "method": "GET",
        "description": "Arranca apps/ejemplo-rest antes de enviar. No llama a NASA: es la API más simple para empezar.",
        "url": {
          "raw": "{{LOCAL_URL}}/api/saludo?nombre=Ada",
          "host": [
            "{{LOCAL_URL}}"
          ],
          "path": [
            "api",
            "saludo"
          ],
          "query": [
            {
              "key": "nombre",
              "value": "Ada"
            }
          ]
        }
      }
    },
    {
      "name": "TechTransfer: patentes de aviones",
      "request": {
        "method": "GET",
        "description": "Busca patentes que contengan «aircraft». El término va al final de la ruta. No necesita clave.",
        "url": {
          "raw": "https://technology.nasa.gov/api/api/patent/aircraft",
          "host": [
            "technology.nasa.gov"
          ],
          "path": [
            "api",
            "api",
            "patent",
            "aircraft"
          ],
          "query": [],
          "protocol": "https"
        }
      }
    },
    {
      "name": "NeoWs: asteroides de una semana",
      "request": {
        "method": "GET",
        "description": "Máximo siete días de rango. Necesita NASA_API_KEY.",
        "url": {
          "raw": "{{BASE_URL}}/neo/rest/v1/feed?start_date=2026-09-26&end_date=2026-10-02&api_key={{NASA_API_KEY}}",
          "host": [
            "{{BASE_URL}}"
          ],
          "path": [
            "neo",
            "rest",
            "v1",
            "feed"
          ],
          "query": [
            {
              "key": "start_date",
              "value": "2026-09-26"
            },
            {
              "key": "end_date",
              "value": "2026-10-02"
            },
            {
              "key": "api_key",
              "value": "{{NASA_API_KEY}}"
            }
          ]
        }
      }
    },
    {
      "name": "DONKI: fulguraciones solares",
      "request": {
        "method": "GET",
        "description": "Aquí las fechas van en camelCase. No necesita clave.",
        "url": {
          "raw": "https://ccmc.gsfc.nasa.gov/DONKI-API/get/FLR?startDate=2026-09-26&endDate=2026-10-02",
          "host": [
            "ccmc.gsfc.nasa.gov"
          ],
          "path": [
            "DONKI-API",
            "get",
            "FLR"
          ],
          "query": [
            {
              "key": "startDate",
              "value": "2026-09-26"
            },
            {
              "key": "endDate",
              "value": "2026-10-02"
            }
          ],
          "protocol": "https"
        }
      }
    },
    {
      "name": "EPIC: últimas imágenes",
      "request": {
        "method": "GET",
        "description": "Metadatos de las imágenes más recientes de la Tierra. No necesita clave.",
        "url": {
          "raw": "https://epic.gsfc.nasa.gov/api/natural",
          "host": [
            "epic.gsfc.nasa.gov"
          ],
          "path": [
            "api",
            "natural"
          ],
          "query": [],
          "protocol": "https"
        }
      }
    },
    {
      "name": "EPIC: imágenes de una fecha",
      "request": {
        "method": "GET",
        "description": "Metadatos de las imágenes de un día. No necesita clave.",
        "url": {
          "raw": "https://epic.gsfc.nasa.gov/api/natural/date/2026-10-01",
          "host": [
            "epic.gsfc.nasa.gov"
          ],
          "path": [
            "api",
            "natural",
            "date",
            "2026-10-01"
          ],
          "query": [],
          "protocol": "https"
        }
      }
    }
  ]
}